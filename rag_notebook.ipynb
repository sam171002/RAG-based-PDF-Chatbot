    "# Ragas evaluation with Gemini + HuggingFace embeddings\n",
    "from datasets import Dataset\n",
    "from ragas.metrics import faithfulness, answer_relevancy\n",
    "from ragas import evaluate as ragas_evaluate\n",
    "from ragas.llms.base import LangchainLLMWrapper\n",
    "from ragas.embeddings.base import LangchainEmbeddingsWrapper\n",
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "from langchain_community.embeddings import HuggingFaceEmbeddings\n",
    "\n",
    "# Wrap Gemini LLM\n",
    "gemini_llm = ChatGoogleGenerativeAI(model=\"gemini-1.5-flash\", api_key=os.environ[\"GOOGLE_API_KEY\"])\n",
    "wrapped_llm = LangchainLLMWrapper(gemini_llm)\n",
    "\n",
    "# Wrap HuggingFace embeddings ",
    "hf_embeddings = HuggingFaceEmbeddings(model_name=\"sentence-transformers/all-MiniLM-L6-v2\")\n",
    "wrapped_embeddings = LangchainEmbeddingsWrapper(hf_embeddings)\n",
    "\n",
    "def evaluate_bot(qa_pairs, k=4):\n",
    "    eval_data = {\"question\": [], \"answer\": [], \"contexts\": [], \"ground_truths\": []}\n",
    "\n",
    "    for qa in qa_pairs:\n",
    "        q = qa[\"question\"]\n",
    "        a = qa[\"answer\"]\n",
    "\n",
    "        bot_result = answer_question(q, k=k)\n",
    "        pred = bot_result[\"answer\"]\n",
    "\n",
    "        eval_data[\"question\"].append(q)\n",
    "        eval_data[\"answer\"].append(pred)\n",
    "        eval_data[\"contexts\"].append([bot_result.get(\"context\", \"\")])\n",
    "        eval_data[\"ground_truths\"].append([a])\n",
    "\n",
    "    dataset = Dataset.from_dict(eval_data)\n",
    "\n",
    "    results = ragas_evaluate(\n",
    "        dataset,\n",
    "        metrics=[faithfulness, answer_relevancy],\n",
    "        llm=wrapped_llm,\n",
    "        embeddings=wrapped_embeddings   \n",
    "    )\n",
    "    return results\n",
    "\n",
    "# Run evaluation\n",
    "results = evaluate_bot(synthetic_qas, k=4)\n",
    "print(results)\n"
   ]
  },
