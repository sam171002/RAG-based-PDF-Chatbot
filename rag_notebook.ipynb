    "# Retrieval helpers\n",
    "from typing import List, Dict\n",
    "\n",
    "def retrieve_top_k(query: str, k: int = 4) -> List[Dict]:\n",
    "    \"\"\"\n",
    "    Search the Chroma vector DB for the top-k relevant chunks.\n",
    "    Each hit returns: { 'text': str, 'page': int }.\n",
    "    \"\"\"\n",
    "    results = vectordb.similarity_search_with_score(query, k=k)\n",
    "\n",
    "    hits = []\n",
    "    for doc, score in results:\n",
    "        hits.append({\n",
    "            \"text\": doc.page_content,\n",
    "            \"page\": doc.metadata.get(\"page\", None),\n",
    "            \"score\": score\n",
    "        })\n",
    "    return hits\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9c807b0e-3fc8-4e10-bb92-debcd4452aef",
   "metadata": {},
   "outputs": [],
   "source": [
    "#  Gemini wrapper\n",
    "import google.generativeai as genai\n",
    "genai.configure(api_key=\"your api key here\")\n",
    "\n",
    "def call_gemini(prompt: str, model: str = \"gemini-1.5-flash\") -> str:\n",
    "    \"\"\"\n",
    "    Call Gemini with a prompt and return plain text response.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        model_obj = genai.GenerativeModel(model)\n",
    "        response = model_obj.generate_content(prompt)\n",
    "        return response.text if hasattr(response, \"text\") else str(response)\n",
    "    except Exception as e:\n",
    "        return f\"[Gemini call failed] {e}\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "4a5183cc-3815-4900-ab5e-067f99b1aee7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RAG answer function\n",
    "import textwrap, re\n",
    "from typing import List, Dict\n",
    "\n",
    "def build_context_from_hits(hits: List[Dict], max_chars: int = 3000) -> str:\n",
    "    \"\"\"\n",
    "    Assemble a context string from retrieved hits.\n",
    "    \"\"\"\n",
    "    parts, char_count = [], 0\n",
    "    for h in hits:\n",
    "        snippet = h[\"text\"].strip().replace(\"\\n\", \" \")\n",
    "        if len(snippet) > 800:  # truncate long chunks\n",
    "            snippet = snippet[:800] + \"...\"\n",
    "        block = f\"[page {h['page']+1 if h['page'] is not None else 'unknown'}] {snippet}\"\n",
    "        if char_count + len(block) > max_chars:\n",
    "            break\n",
    "        parts.append(block)\n",
    "        char_count += len(block)\n",
    "    return \"\\n\\n\".join(parts)\n",
    "\n",
    "def answer_question(question: str, k: int = 4, model: str = \"gemini-1.5-flash\"):\n",
    "    # 1. retrieve\n",
    "    hits = retrieve_top_k(question, k=k)\n",
    "    if not hits:\n",
    "        return {\"answer\": \"No relevant context found.\", \"citations\": [], \"hits\": []}\n",
    "\n",
    "    # 2. build context\n",
    "    context = build_context_from_hits(hits, max_chars=4000)\n",
    "\n",
    "    # 3. craft prompt\n",
    "    prompt = textwrap.dedent(f\"\"\"\n",
    "        You are a helpful assistant. Use ONLY the provided context to answer the question.\n",
    "        If the answer is not in the context, reply exactly with: \"I don't know\".\n",
    "        Provide inline citations in square brackets (e.g., [page 12]).\n",
    "        At the end, list the sources used.\n",
    "\n",
    "        CONTEXT:\n",
    "        {context}\n",
    "\n",
    "        QUESTION:\n",
    "        {question}\n",
    "\n",
    "        ANSWER:\n",
    "    \"\"\").strip()\n",
    "\n",
    "    # 4. call Gemini\n",
    "    resp_text = call_gemini(prompt, model=model)\n",
    "\n",
    "    # 5. extract citations\n",
    "    pages_mentioned = re.findall(r\"\\[page\\s*([0-9]+)\\]\", resp_text, flags=re.IGNORECASE)\n",
    "    pages_mentioned = sorted(set(int(p) for p in pages_mentioned)) if pages_mentioned else []\n",
    "\n",
    "    citations = []\n",
    "    for p in pages_mentioned:\n",
    "        for h in hits:\n",
    "            page_num = h[\"page\"] + 1 if h[\"page\"] is not None else None\n",
    "            if page_num == p:\n",
    "                citations.append({\n",
    "                    \"page\": p,\n",
    "                    \"snippet\": h[\"text\"][:500]\n",
    "                })\n",
    "                break\n",
    "\n",
    "    return {\"answer\": resp_text.strip(), \"citations\": citations, \"hits\": hits, \"context\": context}\n"
   ]
  },
