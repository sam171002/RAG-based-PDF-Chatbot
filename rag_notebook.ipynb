    "# Notebook cell: Synthetic Q/A generation (fixed)\n",
    "import json\n",
    "\n",
    "def clean_json_output(resp: str) -> str:\n",
    "    \"\"\"\n",
    "    Remove markdown code fences (```json ... ```) if present.\n",
    "    \"\"\"\n",
    "    resp = resp.strip()\n",
    "    if resp.startswith(\"```\"):\n",
    "        resp = resp.split(\"```\")[1]  # remove first ```\n",
    "        resp = resp.replace(\"json\", \"\", 1).strip()  # drop 'json' if present\n",
    "    if resp.endswith(\"```\"):\n",
    "        resp = resp[:-3].strip()\n",
    "    return resp\n",
    "\n",
    "def generate_synthetic_qa(chunks, num_questions=10, model=\"gemini-1.5-flash\"):\n",
    "    qa_pairs = []\n",
    "\n",
    "    for i, doc in enumerate(chunks[:num_questions]):\n",
    "        context = doc.page_content\n",
    "        prompt = f\"\"\"\n",
    "        You are tasked with generating a question and its correct answer based ONLY on the context provided.\n",
    "\n",
    "        Context:\n",
    "        {context}\n",
    "\n",
    "        Output format (strict JSON, no explanations, no code fences):\n",
    "        {{\n",
    "          \"question\": \"...\",\n",
    "          \"answer\": \"...\"\n",
    "        }}\n",
    "        \"\"\"\n",
    "\n",
    "        resp = call_gemini(prompt, model=model)\n",
    "\n",
    "        # Clean response\n",
    "        resp_clean = clean_json_output(resp)\n",
    "\n",
    "        try:\n",
    "            qa = json.loads(resp_clean)\n",
    "            qa[\"source_page\"] = doc.metadata.get(\"page\", None)\n",
    "            qa_pairs.append(qa)\n",
    "        except Exception as e:\n",
    "            print(f\"Skipping chunk {i} due to parse error: {e}\")\n",
    "            print(\"Raw output:\", resp[:300])\n",
    "\n",
    "    return qa_pairs\n",
    "\n",
    "\n",
    "# Test again\n",
    "synthetic_qas = generate_synthetic_qa(chunks, num_questions=5)\n",
    "for qa in synthetic_qas:\n",
    "    print(f\"Q: {qa['question']}\\nA: {qa['answer']}\\nPage: {qa['source_page']}\\n---\")\n"
   ]
